# RecipeHub API - environment variables
#
# Copy to .env for local development. In production these are set in the
# Render dashboard (Service -> Environment), never committed.

# --- Required -------------------------------------------------------------

# MongoDB Atlas connection string. Atlas gives you this under Connect ->
# Drivers. Replace <db_password> with the database user's password; it is
# not the same as your Atlas account password.
MONGO_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/recipehub?retryWrites=true&w=majority

# Signs and verifies login tokens. Any long random string; changing it logs
# everyone out. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Image and video hosting. From the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Required once the frontend is not on its default Render URL ----------

# Comma-separated list of origins allowed to call this API, which is both
# the CORS allowlist and the Socket.IO handshake allowlist. Add the custom
# domain here the same day you attach it, or the frontend will look like it
# has no backend. Include the www variant if you use one.
#   CORS_ORIGINS=https://recipehub.com,https://www.recipehub.com
# Leave unset to allow localhost plus the current Render frontend URL.
CORS_ORIGINS=

# --- Optional -------------------------------------------------------------

# Error reporting. Create a project at sentry.io (Node.js platform) and
# paste its DSN. Unset means no reporting and no SDK overhead.
SENTRY_DSN=
# Fraction of requests traced for performance, 0 to 1. Errors are always
# sent regardless. Lower this if you are near the free-tier quota.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Redis cache. Without it the app runs uncached, which is fine at small
# scale; the log says so at startup.
REDIS_URL=

# Set automatically by Render. Only needed locally if 5000 is taken.
PORT=5000

# "production" tightens error responses so internal messages are not
# returned to clients. Render sets this for you.
NODE_ENV=development
